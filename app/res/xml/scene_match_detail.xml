<?xml version="1.0" encoding="utf-8"?>
<MotionScene
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto" xmlns:app="http://schemas.android.com/apk/res-auto">
    <ConstraintSet android:id="@id/start">
        <Constraint android:id="@id/topPanel">
            <PropertySet android:alpha="1.0" />
            <Layout android:layout_width="0.0dip" android:layout_height="310.0dip" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        </Constraint>
        <Constraint android:id="@id/bottomPanel">
            <PropertySet android:alpha="1.0" />
            <Layout android:layout_width="0.0dip" android:layout_height="540.0dip" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/topPanel" />
        </Constraint>
    </ConstraintSet>
    <ConstraintSet android:id="@id/expanded">
        <Constraint android:id="@id/topPanel">
            <PropertySet android:alpha="0.0" />
            <Layout android:visibility="gone" android:layout_width="0.0dip" android:layout_height="310.0dip" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        </Constraint>
        <Constraint android:id="@id/bottomPanel">
            <PropertySet android:alpha="1.0" />
            <Layout android:layout_width="0.0dip" android:layout_height="540.0dip" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
        </Constraint>
    </ConstraintSet>
    <Transition app:constraintSetEnd="@id/expanded" app:constraintSetStart="@id/start" app:duration="400">
        <OnSwipe app:dragDirection="dragUp" app:onTouchUp="autoComplete" app:touchAnchorId="@id/bottomPanel" app:touchAnchorSide="top" app:touchRegionId="@id/lvp" />
    </Transition>
</MotionScene>